---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="border-t border-neutral-800 mt-16">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 text-center text-neutral-500 text-sm">
      <pre class="font-code text-neutral-600 text-xs text-center select-none">
{`          .--.
         |o_o |
         |:_/ |
        //   \\ \\
       (|     | )
      /'\\_   _/ \`\\
      \\___)=(___/`}
      </pre>
    <p class="font-code text-neutral-600 my-4 tracking-widest">
      //- - - [ EOF ] - - -//
    </p>
    <p>{t('copyright')}</p>
  </div>
</footer>
