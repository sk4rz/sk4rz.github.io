---
import { getLangFromUrl } from '../i18n/utils';
import Tag from './Tag.astro';

export interface Props {
  post: any; // using any for now since we will use Astro collection types later
}

const { post } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const postUrl = `/${lang}/post/${post.slug}`;

// we assume post is already mapped to extract language, or we extract it here from post.data
// Wait, let's just use what they have locally in the format:
const title = post.data?.title?.[lang] || post.title?.[lang];
const date = post.data?.date || post.date;
const excerpt = post.data?.excerpt?.[lang] || post.excerpt?.[lang];
const tags = post.data?.tags || post.tags || [];
---

<article class="bg-white/5 p-6 border border-white/10 rounded-lg shadow-lg transition-all duration-300 hover:bg-white/10 hover:border-white/20">
  <header>
    <h2 class="text-3xl font-display text-white mb-2">
      <a href={postUrl} class="hover:text-violet-400 transition-colors">
         {title}
      </a>
    </h2>
    <p class="text-sm text-neutral-500">{date}</p>
  </header>
  <div class="mt-4 text-neutral-300">
    <p class="text-justify">{excerpt}</p>
  </div>
  <footer class="mt-6 flex flex-wrap gap-2">
    {tags.map((tag: string) => <Tag name={tag} />)}
  </footer>
</article>
